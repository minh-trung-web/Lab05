              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Request without token is rejected', function () {\r",
                  "    pm.expect([401, 403]).to.include(pm.response.code);\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
