        {
          "name": "6. POST - Create User With Duplicate Email",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Duplicate email is rejected with 422', function () {\r",
                  "    pm.response.to.have.status(422);\r",
                  "});\r",
                  "\r",
                  "if (pm.response.code === 422) {\r",
                  "    const data = pm.response.json();\r",
                  "\r",
                  "    pm.test('Response confirms duplicate email', function () {\r",
                  "        pm.expect(JSON.stringify(data)).to.include('email');\r",
                  "        pm.expect(JSON.stringify(data)).to.include('has already been taken');\r",
                  "    });\r",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
