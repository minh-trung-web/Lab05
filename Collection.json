                  "",
                  "if (pm.response.code === 200) {",
                  "    const data = pm.response.json();",
                  "",
                  "    pm.test('User status is inactive', function () {",
                  "        pm.expect(data.status).to.eql('inactive');",
                  "    });",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
